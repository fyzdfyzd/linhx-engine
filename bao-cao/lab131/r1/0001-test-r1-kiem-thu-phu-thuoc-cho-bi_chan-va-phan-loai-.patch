+def test_d_cha_truot_han_sinh_dung_1_tep_phan_loai_co_con_sha_va_3_lua_chon(tmp_path, monkeypatch):
+    # (d) Cha trượt hẳn sinh đúng 1 tệp `hang-doi/can-linh/<id cha>-phan-loai.md`
