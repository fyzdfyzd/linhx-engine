+def test_a_cha_truot_con_o_lai_moi_them_bi_chan_khong_sinh_ket_qua_huy(tmp_path, monkeypatch):
+    # (a) Phiếu cha trượt -> phiếu con ở lại `moi/`, thêm header `bi_chan: <id cha> <ly do>`,
+    # KHÔNG sinh KET-QUA trạng thái `huy`.
+    bare_repo = _create_bare_queue_repo(
+        tmp_path,
+        initial_tickets={
+            "01-cha": "may: may-1\nloai: code\n\nBước cha bị lỗi thực thi.",
+            "02-con": "may: may-1\nloai: code\nphu_thuoc: 01-cha\n\nBước con trực tiếp chờ bước cha.",
+            "03-con-fm": "---\nmay: bat-ky\nloai: code\nphu_thuoc: 01-cha\n---\nBước con dùng frontmatter.",
+            "04-chau": "may: may-1\nloai: code\nphu_thuoc: 02-con\n\nBước cháu phụ thuộc bắc cầu.",
+        },
+    )
+    cfg = _clone_worker_cfg(bare_repo, tmp_path, "may-1")
+
+    def fake_agy(_cfg, job):
+        assert job["viec"] == "01-cha"
+        return "loi", "Thiếu bảng dữ liệu migration", "exit=1", 15, 5
+
+    monkeypatch.setattr(hang_doi_git, "chay_agy", fake_agy)
+    res = hang_doi_git.xu_ly_mot_phieu(cfg)
+    assert res is not None and res["viec"] == "01-cha" and res["trang_thai"] == "loi"
+
+    ins = _inspect_queue_branch(bare_repo, tmp_path, "kt-a")
+    for child_id in ("02-con", "03-con-fm", "04-chau"):
+        assert not (ins / "hang-doi" / "xong" / child_id / "KET-QUA.md").exists()
+        assert (ins / "hang-doi" / "moi" / f"{child_id}.md").is_file()
+
+    con_text = (ins / "hang-doi" / "moi" / "02-con.md").read_text(encoding="utf-8")
+    _assert_has_bi_chan_header(con_text, "02-con", "01-cha")
+    parsed_con = hang_doi_git.phan_tich_phieu(con_text, "02-con")
+    assert parsed_con["phu_thuoc"] == ["01-cha"]
+    assert parsed_con["de"] == "Bước con trực tiếp chờ bước cha."
+
+    con_fm_text = (ins / "hang-doi" / "moi" / "03-con-fm.md").read_text(encoding="utf-8")
+    _assert_has_bi_chan_header(con_fm_text, "03-con-fm", "01-cha")
+    parsed_fm = hang_doi_git.phan_tich_phieu(con_fm_text, "03-con-fm")
+    assert parsed_fm["de"] == "Bước con dùng frontmatter."
+
+    # Phiếu con đẩy vào sau khi cha đã trượt cũng ở lại `moi/` với `bi_chan`, không bị huỷ
+    (ins / "hang-doi" / "moi" / "05-con-vao-muon.md").write_text(
+        "may: may-1\nloai: code\nphu_thuoc: 01-cha\n\nPhiếu con vào sau khi cha đã trượt.\n",
+        encoding="utf-8",
+    )
+    _git_commit(ins, "them 05-con-vao-muon", author="pusher")
+    _run_git(["push", "origin", "hang-doi"], ins)
+
+    assert hang_doi_git.nhan_phieu_git(cfg) is None
+    ins_late = _inspect_queue_branch(bare_repo, tmp_path, "kt-a-late")
+    assert not (ins_late / "hang-doi" / "xong" / "05-con-vao-muon" / "KET-QUA.md").exists()
+    late_text = (ins_late / "hang-doi" / "moi" / "05-con-vao-muon.md").read_text(encoding="utf-8")
+    _assert_has_bi_chan_header(late_text, "05-con-vao-muon", "01-cha")
+
