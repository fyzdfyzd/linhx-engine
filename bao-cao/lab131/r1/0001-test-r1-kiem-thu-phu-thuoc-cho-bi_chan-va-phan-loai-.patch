+        initial_tickets={
+            "01-cha": "may: may-1\nloai: code\n\nCha trượt hẳn rồi được tạo phiếu -sua-k để sửa.",
+            "02-con": "may: may-2\nloai: code\nphu_thuoc: 01-cha\n\nCon chờ 01-cha hoặc 01-cha-sua-k.",
+        },
+    )
+    cfg1 = _clone_worker_cfg(bare_repo, tmp_path, "may-1")
+    cfg2 = _clone_worker_cfg(bare_repo, tmp_path, "may-2")
+    da_chay: list[str] = []
+
+    def fake_agy(_cfg, job):
+        da_chay.append(job["viec"])
+        if job["viec"] in ("01-cha", "01-cha-sua-1"):
+            return "loi", f"Trượt ở {job['viec']}", "exit=1", 10, 5
+        return "xong", f"Đạt ở {job['viec']}", "exit=0", 20, 10
+
+    monkeypatch.setattr(hang_doi_git, "chay_agy", fake_agy)
+
+    # 1. 01-cha trượt -> 02-con có bi_chan
+    r0 = hang_doi_git.xu_ly_mot_phieu(cfg1)
+    assert r0 is not None and r0["viec"] == "01-cha" and r0["trang_thai"] == "loi"
+    ins0 = _inspect_queue_branch(bare_repo, tmp_path, "kt-c2-blocked")
+    _assert_has_bi_chan_header(
+        (ins0 / "hang-doi" / "moi" / "02-con.md").read_text(encoding="utf-8"),
+        "02-con",
+        "01-cha",
+    )
+
+    # 2. Tạo phiếu 01-cha-sua-1 (tu_sua: 1): trượt ở sua-1 -> tự sinh sua-2 -> đạt `xong` ở sua-2
+    (ins0 / "hang-doi" / "moi" / "01-cha-sua-1.md").write_text(
+        "may: may-1\nloai: code\ntu_sua: 1\n\nSửa tiếp phiếu 01-cha.\n",
+        encoding="utf-8",
+    )
+    _git_commit(ins0, "them 01-cha-sua-1", author="admin")
+    _run_git(["push", "origin", "hang-doi"], ins0)
+
+    r_sua1 = hang_doi_git.xu_ly_mot_phieu(cfg1)
+    assert r_sua1 is not None and r_sua1["viec"] == "01-cha-sua-1" and r_sua1["trang_thai"] == "loi"
+    assert hang_doi_git.nhan_phieu_git(cfg2) is None
+
+    r_sua2 = hang_doi_git.xu_ly_mot_phieu(cfg1)
+    assert r_sua2 is not None and r_sua2["viec"] == "01-cha-sua-2" and r_sua2["trang_thai"] == "xong"
+
+    # 3. Dòng bi_chan trong 02-con.md đã bị xoá và may-2 chạy xong 02-con
+    ins_after = _inspect_queue_branch(bare_repo, tmp_path, "kt-c2-unblocked")
+    con_after = (ins_after / "hang-doi" / "moi" / "02-con.md").read_text(encoding="utf-8")
+    assert "bi_chan" not in hang_doi_git.phan_tich_phieu(con_after, "02-con")["meta"]
+    assert not re.search(r"(?m)^bi_chan\s*:", con_after)
+
+    r_con = hang_doi_git.xu_ly_mot_phieu(cfg2)
+    assert r_con is not None and r_con["viec"] == "02-con" and r_con["trang_thai"] == "xong"
+    assert da_chay == ["01-cha", "01-cha-sua-1", "01-cha-sua-2", "02-con"]
+
