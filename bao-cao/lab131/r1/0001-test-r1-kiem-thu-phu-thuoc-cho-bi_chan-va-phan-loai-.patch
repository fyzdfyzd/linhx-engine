+def test_c_luot_sua_cua_cha_dat_xong_xoa_bi_chan_va_con_chay_duoc(tmp_path, monkeypatch):
+    # (c) Khi lượt `-sua-k` của cha đạt `xong`, dòng `bi_chan` bị xoá và phiếu con chạy được.
