+            _git_commit(proj_wt, "feat: lam xong 90% core", author="tho-1")
+            sha_cuoi = _run_git(["rev-parse", "HEAD"], proj_wt)
+            _run_git(["push", "origin", "HEAD:refs/heads/main"], proj_wt)
+            _run_git(["push", "origin", "HEAD:refs/heads/lx-cha"], proj_wt)
+            sha_cuoi_holder.append(sha_cuoi)
+            return "loi", f"Trượt 1 test biên cuối; SHA: {sha_cuoi}", "exit=1", 30, 12
+        raise AssertionError(f"Không được chạy phiếu khác: {job['viec']}")
+
+    monkeypatch.setattr(hang_doi_git, "chay_agy", fake_agy)
+
+    # Lượt 1: còn lượt tự sửa `lx-cha-sua-1` nên cha chưa trượt hẳn -> chưa sinh tệp phân loại
