+def test_b_phieu_con_co_bi_chan_khong_duoc_nhan(tmp_path):
+    # (b) Phiếu con có header `bi_chan` không được chọn trong `chon_ung_vien` hay nhận bởi `nhan_phieu_git`.
+    bare_repo = _create_bare_queue_repo(
+        tmp_path,
+        initial_tickets={
+            "01-con-bi-chan": (
+                "may: may-1\n"
+                "loai: code\n"
+                "bi_chan: 00-cha-loi loi - trượt kiểm thử\n\n"
+                "Phiếu đang mang cờ bi_chan thì không được nhận."
+            ),
+            "02-con-phu-thuoc-bi-chan": (
+                "may: may-1\n"
+                "loai: code\n"
+                "phu_thuoc: 00-cha-loi\n"
+                "bi_chan: 00-cha-loi loi - trượt kiểm thử\n\n"
+                "Phiếu phụ thuộc cha lỗi đang bị chặn."
+            ),
+            "03-phieu-sach": "may: may-1\nloai: code\n\nPhiếu bình thường không bị chặn.",
+        },
+        finished_results={
+            "00-cha-loi": hang_doi_git.tao_ket_qua_md("00-cha-loi", "may-1", "loi", "Trượt kiểm thử"),
+        },
+    )
+    cfg = _clone_worker_cfg(bare_repo, tmp_path, "may-1")
+    wt = hang_doi_git.dam_bao_worktree(cfg)
+    assert wt is not None
+
+    ung_vien_ids = [v["viec"] for _, v in hang_doi_git.chon_ung_vien(wt, "may-1", cfg=cfg)]
+    assert ung_vien_ids == ["03-phieu-sach"]
+
+    claimed = hang_doi_git.nhan_phieu_git(cfg)
+    assert claimed is not None and claimed["viec"] == "03-phieu-sach"
+    assert hang_doi_git.nhan_phieu_git(cfg) is None
+
+    ins = _inspect_queue_branch(bare_repo, tmp_path, "kt-b")
+    assert (ins / "hang-doi" / "moi" / "01-con-bi-chan.md").is_file()
+    assert (ins / "hang-doi" / "moi" / "02-con-phu-thuoc-bi-chan.md").is_file()
+    assert not (ins / "hang-doi" / "dang" / "01-con-bi-chan.md").exists()
+    assert not (ins / "hang-doi" / "dang" / "02-con-phu-thuoc-bi-chan.md").exists()
+
