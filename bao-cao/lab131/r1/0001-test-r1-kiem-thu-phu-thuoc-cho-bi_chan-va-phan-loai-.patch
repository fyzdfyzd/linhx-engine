+def test_c_cha_dat_xong_xoa_dong_bi_chan_va_con_chay_duoc(tmp_path, monkeypatch):
+    # (c) Khi chính phiếu cha đạt `xong`, dòng `bi_chan` trên phiếu con bị xoá và con chạy được.
+    bare_repo = _create_bare_queue_repo(
+        tmp_path,
+        initial_tickets={
+            "01-cha": "may: may-1\nloai: code\n\nBước cha trượt lần đầu rồi chạy lại đạt xong.",
+            "02-con": "may: may-2\nloai: code\nphu_thuoc: 01-cha\n\nBước con của may-2 chờ 01-cha.",
+        },
+    )
+    cfg1 = _clone_worker_cfg(bare_repo, tmp_path, "may-1")
+    cfg2 = _clone_worker_cfg(bare_repo, tmp_path, "may-2")
+    lan_chay_cha = [0]
+
+    def fake_agy(_cfg, job):
+        if job["viec"] == "01-cha":
+            lan_chay_cha[0] += 1
+            if lan_chay_cha[0] == 1:
+                return "dung", None, "dừng agy: quá 20 phút không tiến", 0, 0
+            return "xong", "Cha chạy lại thành công", "exit=0", 20, 10
+        return "xong", f"Hoàn tất {job['viec']}", "exit=0", 15, 8
+
+    monkeypatch.setattr(hang_doi_git, "chay_agy", fake_agy)
+
+    # Lần 1: 01-cha dừng -> 02-con bị gắn bi_chan và may-2 không nhận được
+    r1 = hang_doi_git.xu_ly_mot_phieu(cfg1)
+    assert r1 is not None and r1["viec"] == "01-cha" and r1["trang_thai"] == "dung"
+    ins1 = _inspect_queue_branch(bare_repo, tmp_path, "kt-c1")
+    _assert_has_bi_chan_header(
+        (ins1 / "hang-doi" / "moi" / "02-con.md").read_text(encoding="utf-8"),
+        "02-con",
+        "01-cha",
+    )
+    assert hang_doi_git.nhan_phieu_git(cfg2) is None
+
+    # Đẩy lại 01-cha vào moi/ để chạy lại và đạt `xong`
+    (ins1 / "hang-doi" / "moi" / "01-cha.md").write_text(
+        "may: may-1\nloai: code\n\nBước cha chạy lại sau khi xử lý sự cố.\n",
+        encoding="utf-8",
+    )
+    _git_commit(ins1, "gui lai 01-cha", author="admin")
+    _run_git(["push", "origin", "hang-doi"], ins1)
+
+    r2 = hang_doi_git.xu_ly_mot_phieu(cfg1)
+    assert r2 is not None and r2["viec"] == "01-cha" and r2["trang_thai"] == "xong"
+
+    ins2 = _inspect_queue_branch(bare_repo, tmp_path, "kt-c1-unblocked")
+    con_unblocked = (ins2 / "hang-doi" / "moi" / "02-con.md").read_text(encoding="utf-8")
+    parsed_con = hang_doi_git.phan_tich_phieu(con_unblocked, "02-con")
+    assert "bi_chan" not in parsed_con["meta"]
+    assert not re.search(r"(?m)^bi_chan\s*:", con_unblocked)
+    assert parsed_con["de"] == "Bước con của may-2 chờ 01-cha."
+
+    # may-2 nay nhận được 02-con và chạy xong
+    r_con = hang_doi_git.xu_ly_mot_phieu(cfg2)
+    assert r_con is not None and r_con["viec"] == "02-con" and r_con["trang_thai"] == "xong"
+
