+def _doc_chi_tiet_ket_qua_cha(wt: Path, dep_id: str) -> tuple[str, str, str]:
+    # Đọc (trang_thai, ly_do_ngan, sha_cuoi) từ `KET-QUA.md` của phiếu cha (hoặc lượt `-sua-<k>` cuối)
+    effective_id = _effective_dependency_result_id(wt, dep_id)
+    if not effective_id:
+        return "loi", f"loi - {DEPENDENCY_FAILED_REASON}", ""
+    goc_hd = thu_muc_hang_doi(wt)
+    tep_kq = goc_hd / "xong" / effective_id / "KET-QUA.md"
+    if not tep_kq.is_file():
+        return "loi", f"loi - {DEPENDENCY_FAILED_REASON}", ""
+    try:
+        raw = tep_kq.read_text(encoding="utf-8", errors="replace").lstrip("\ufeff")
+    except OSError:
+        return "loi", f"loi - {DEPENDENCY_FAILED_REASON}", ""
+
+    lines = raw.splitlines()
+    meta_kq: dict[str, str] = {}
+    body_idx = 0
+    if lines and lines[0].strip() == "---":
+        for idx in range(1, len(lines)):
+            if lines[idx].strip() == "---":
+                for hl in lines[1:idx]:
+                    mh = _KHOA_DAU_DONG.match(hl.strip())
+                    if mh:
+                        meta_kq[mh.group(1).lower()] = mh.group(2).strip()
+                body_idx = idx + 1
+                break
+    else:
+        for idx, hl in enumerate(lines):
+            if not hl.strip():
+                body_idx = idx + 1
+                break
+            mh = _KHOA_DAU_DONG.match(hl.strip())
+            if not mh:
+                body_idx = idx
+                break
+            meta_kq[mh.group(1).lower()] = mh.group(2).strip()
+        else:
+            body_idx = len(lines)
+
+    tt = (meta_kq.get("trang_thai") or "loi").split("#", 1)[0].strip().lower() or "loi"
+    ly_do_hdr = (meta_kq.get("ly_do") or "").strip()
+    than_lines = lines[body_idx:]
+    than_txt = "\n".join(than_lines).strip()
+    dong_dau = ""
+    for dl in than_lines:
+        s = dl.strip()
+        if s and not s.startswith("---"):
+            dong_dau = s
+            break
+    chi_tiet = dong_dau or ly_do_hdr or DEPENDENCY_FAILED_REASON
+    ly_do_ngan = _cat_mot_dong(f"{tt} - {chi_tiet}", 160)
+
+    sha_tim = ""
+    m_lbl = _SHA_LABELED_RE.search(than_txt)
+    if m_lbl:
+        sha_tim = m_lbl.group(1)
+    else:
+        m_40 = _SHA_FULL40_RE.search(than_txt)
+        if m_40:
+            sha_tim = m_40.group(1)
+    return tt, ly_do_ngan, sha_tim
+
