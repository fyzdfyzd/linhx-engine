+def cap_nhat_header_bi_chan(noi_dung: str, gia_tri_bi_chan: str | None) -> str:
+    # Thêm/cập nhật hoặc xoá dòng `bi_chan: <id cha> <ly do>` trong phần header của phiếu ở `moi/`
+    van_ban = noi_dung.lstrip("\ufeff")
+    cac_dong = van_ban.splitlines()
+    co_xuong_dong_cuoi = van_ban.endswith("\n")
+    gia_tri_sach = " ".join(str(gia_tri_bi_chan or "").splitlines()).strip()
+
+    if cac_dong and cac_dong[0].strip() == "---":
+        for i in range(1, len(cac_dong)):
+            if cac_dong[i].strip() == "---":
+                phan_dau = [d for d in cac_dong[1:i] if not _la_dong_bi_chan(d)]
+                if gia_tri_sach:
+                    phan_dau.append(f"bi_chan: {gia_tri_sach}")
+                moi = [cac_dong[0], *phan_dau, *cac_dong[i:]]
+                return "\n".join(moi) + ("\n" if co_xuong_dong_cuoi else "")
+
+    phan_dau_thuong: list[str] = []
+    vi_tri = 0
+    for i, dong in enumerate(cac_dong):
+        s = dong.strip()
+        if not s:
+            vi_tri = i
+            break
+        if _tach_cap_khoa_gia_tri(s):
+            vi_tri = i + 1
+            if not _la_dong_bi_chan(s):
+                phan_dau_thuong.append(dong)
+        else:
+            vi_tri = i
+            break
+    if gia_tri_sach:
+        phan_dau_thuong.append(f"bi_chan: {gia_tri_sach}")
+    phan_con_lai = cac_dong[vi_tri:]
+    if phan_dau_thuong and phan_con_lai and phan_con_lai[0].strip() != "":
+        moi_thuong = [*phan_dau_thuong, "", *phan_con_lai]
+    else:
+        moi_thuong = [*phan_dau_thuong, *phan_con_lai]
+    return "\n".join(moi_thuong) + ("\n" if co_xuong_dong_cuoi else "")
+
