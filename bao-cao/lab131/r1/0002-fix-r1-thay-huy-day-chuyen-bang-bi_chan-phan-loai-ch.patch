+            ds_huy = _huy_chuoi_trong_wt(wt_sync, ma_muc_tieu, tho=tho_dung, ly_do=ly_do)
+            da_xoa_pl = co_pl_truoc and not tep_pl_goc.exists()
+            if not ds_huy and not da_xoa_pl:
