+    if isinstance(phieu_id, dict) and isinstance(cfg_hoac_wt, str):
+        cfg = phieu_id
+        ma_muc_tieu = cfg_hoac_wt
+    elif isinstance(phieu_id, Path) and isinstance(cfg_hoac_wt, str):
+        wt = phieu_id
+        ma_muc_tieu = cfg_hoac_wt
+    else:
+        ma_muc_tieu = str(phieu_id or "").strip()
+        if isinstance(cfg_hoac_wt, dict) and cfg is None:
+            cfg = cfg_hoac_wt
+        elif isinstance(cfg_hoac_wt, (Path, str)) and wt is None:
+            wt = Path(cfg_hoac_wt)
+
+    if wt is not None and (cfg is None or push is False):
+        wt_path = Path(wt)
+        tho_dung = tho or (str(cfg.get("tho")) if isinstance(cfg, dict) and cfg.get("tho") else "linh")
+        return _huy_chuoi_trong_wt(wt_path, ma_muc_tieu, tho=tho_dung, ly_do=ly_do)
+
+    cfg_dung = cfg if isinstance(cfg, dict) else linhx_runner.doc_env()
+    _, _, remote, nhanh = _duong_dan_wt(cfg_dung)
+    tho_dung = tho or str(cfg_dung.get("tho") or "linh")
+    co_push = True if push is None else bool(push)
+    loi_cuoi = ""
+    with _khoa_tep(_duong_dan_khoa_wt(cfg_dung)):
+        for lan in range(SO_LAN_THU_PUSH):
+            wt_sync = dam_bao_worktree(cfg_dung)
