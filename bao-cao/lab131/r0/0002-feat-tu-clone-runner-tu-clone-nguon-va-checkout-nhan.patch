+def _xoa_thu_muc_clone_do(duong_dan: Path) -> None:
+    if not duong_dan.exists():
+        return
+
+    def _go_chi_doc(fn, p, _):
+        try:
+            os.chmod(p, stat.S_IWRITE)
+            fn(p)
+        except OSError:
+            pass
+
+    try:
+        shutil.rmtree(duong_dan, onerror=_go_chi_doc)
+    except OSError:
+        pass
+
+
+def _chay_git_co_tran(args: list[str], cwd: Path, timeout_seconds: float) -> tuple[int, str, bool]:
+    # Chạy git tiền cảnh có trần thời gian và diệt sạch cây tiến trình con khi quá hạn
+    if chay_git is not _CHAY_GIT_GOC:
+        try:
+            p = chay_git(args, cwd=cwd, check=False, timeout=timeout_seconds)
+            sep = "\n" if p.stdout and p.stderr and not p.stdout.endswith("\n") else ""
+            out_txt = ((p.stdout or "") + sep + (p.stderr or "")).strip()
+            return p.returncode, out_txt, False
+        except subprocess.TimeoutExpired as exc:
+            out_e = (exc.stdout or "") if isinstance(exc.stdout, str) else ""
+            err_e = (exc.stderr or "") if isinstance(exc.stderr, str) else ""
+            return -1, (out_e + "\n" + err_e).strip(), True
+        except Exception as exc:
+            return -1, str(exc), False
+
+    env = os.environ.copy()
+    env["GIT_TERMINAL_PROMPT"] = "0"
+    kw = {"creationflags": 0x08000000} if os.name == "nt" else {"start_new_session": True}
+    popen_fn = linhx_runner._POPEN_GOC
+    try:
+        proc = popen_fn(
+            ["git"] + list(args),
+            cwd=str(cwd),
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            bufsize=0,
+            **kw,
+        )
+    except OSError as exc:
+        return -1, f"không chạy được git: {exc}", False
+
+    out_chunks: list[bytes] = []
+    err_chunks: list[bytes] = []
+
+    def _drain_pipe(pipe, sink: list[bytes]) -> None:
+        if pipe is None:
+            return
+        try:
+            while True:
+                chunk = pipe.read(4096)
+                if not chunk:
+                    break
+                sink.append(chunk if isinstance(chunk, bytes) else chunk.encode("utf-8", errors="replace"))
+        except Exception:
+            pass
+        finally:
+            try:
+                pipe.close()
+            except Exception:
+                pass
+
+    t_out = threading.Thread(target=_drain_pipe, args=(proc.stdout, out_chunks), daemon=True)
+    t_err = threading.Thread(target=_drain_pipe, args=(proc.stderr, err_chunks), daemon=True)
+    t_out.start()
+    t_err.start()
+
+    deadline = time.monotonic() + max(0.05, float(timeout_seconds))
+    step = min(0.2, max(0.01, float(timeout_seconds) / 20.0))
+    timed_out = False
+    try:
+        while proc.poll() is None:
+            if time.monotonic() >= deadline:
+                timed_out = True
+                linhx_runner.dung_tien_trinh_agy(proc)
+                break
+            time.sleep(step)
+    finally:
+        if proc.poll() is None:
+            linhx_runner.dung_tien_trinh_agy(proc)
+        t_out.join(timeout=2.0)
+        t_err.join(timeout=2.0)
+
+    stdout_txt = b"".join(out_chunks).decode("utf-8", errors="replace")
+    stderr_txt = b"".join(err_chunks).decode("utf-8", errors="replace")
+    sep = "\n" if stdout_txt and stderr_txt and not stdout_txt.endswith("\n") else ""
+    combined = (stdout_txt + sep + stderr_txt).replace("\r\n", "\n").replace("\r", "\n").strip()
+    rc = -1 if timed_out else (proc.returncode if proc.returncode is not None else -1)
+    return rc, combined, timed_out
+
