+
+    tran_phut = linhx_runner._ep_so_duong((cfg or {}).get("tran_clone_phut"), CLONE_TIMEOUT_MINUTES)
+    tran_giay = tran_phut * 60.0
+    han_chot = time.monotonic() + tran_giay
+    t0_clone = time.monotonic()
+    try:
+        target.parent.mkdir(parents=True, exist_ok=True)
