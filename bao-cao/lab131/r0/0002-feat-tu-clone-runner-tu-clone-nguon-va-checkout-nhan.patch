+def _unquote_outer(raw_text: str) -> str:
+    s = str(raw_text or "").strip()
+    if len(s) >= 2 and s[0] == s[-1] and s[0] in ("'", '"'):
+        return s[1:-1].strip()
+    return s
+
+
+def _hop_le_ten_nhanh_git(ten: str) -> bool:
+    # Kiểm tra tên nhánh git an toàn (chặn cờ `-...`, khoảng trắng, `..`, ký tự điều khiển)
+    if not ten:
+        return False
+    if ten[0] in ("-", "/", ".") or ten[-1] in ("/", ".") or ten.endswith(".lock"):
+        return False
+    if any(ch.isspace() or ord(ch) < 32 for ch in ten):
+        return False
+    for cam in ("..", "~", "^", ":", "?", "*", "[", "\\", "@{", "//"):
+        if cam in ten:
+            return False
+    return True
+
+
+def tach_nguon(raw_value) -> tuple[bool, str, str, str]:
+    # Tách header `nguon: <url> <nhanh>` -> (co_khai_bao, url, nhanh, thong_diep_loi)
+    if raw_value is None:
+        return False, "", "", ""
+    if isinstance(raw_value, (tuple, list)):
+        if len(raw_value) == 0:
+            return False, "", "", ""
+        if len(raw_value) != 2:
+            return True, "", "", "header nguon phải có dạng '<url> <nhanh>'"
+        url = _unquote_outer(str(raw_value[0] or ""))
+        nhanh = _unquote_outer(str(raw_value[1] or ""))
+    elif isinstance(raw_value, dict):
+        url = _unquote_outer(str(raw_value.get("url") or ""))
+        nhanh = _unquote_outer(str(raw_value.get("nhanh") or ""))
+        if not url and not nhanh:
+            return False, "", "", ""
+    else:
+        cleaned = _strip_unquoted_comment(str(raw_value)).strip()
+        if not cleaned:
+            return False, "", "", ""
+        if cleaned[0] in ("'", '"'):
+            end_q = cleaned.find(cleaned[0], 1)
+            if end_q < 0:
+                return True, "", "", f"header nguon thiếu dấu đóng nháy: {cleaned}"
+            url = cleaned[1:end_q].strip()
+            nhanh = _unquote_outer(cleaned[end_q + 1 :].strip())
+            if any(ch.isspace() for ch in nhanh):
+                return True, "", "", f"header nguon dư tham số: {cleaned}"
+        else:
+            parts = cleaned.split()
+            if len(parts) == 2:
+                url, nhanh = parts[0], parts[1]
+            elif len(parts) > 2:
+                left, right = cleaned.rsplit(None, 1)
+                if Path(left.strip()).exists():
+                    url, nhanh = left.strip(), right.strip()
+                else:
+                    return True, "", "", f"header nguon phải có dạng '<url> <nhanh>': {cleaned}"
+            else:
+                return True, "", "", f"header nguon thiếu nhánh '<url> <nhanh>': {cleaned}"
+
+    if not url or not nhanh:
+        return True, "", "", "header nguon thiếu url hoặc nhánh"
+    if url.startswith("-"):
+        return True, "", "", f"url nguồn không hợp lệ: {url}"
+    if not _hop_le_ten_nhanh_git(nhanh):
+        return True, "", "", f"nhánh nguồn không hợp lệ: {nhanh}"
+    return True, url, nhanh, ""
+
+
+def parse_nguon(raw_value) -> tuple[str, str] | None:
+    co_khai_bao, url, nhanh, loi = tach_nguon(raw_value)
+    if not co_khai_bao or loi:
+        return None
+    return (url, nhanh)
+
+
+def tach_nhanh_moi(raw_value) -> tuple[bool, str, str]:
+    # Tách header `nhanh_moi: <ten>` -> (co_khai_bao, nhanh_moi, thong_diep_loi)
+    if raw_value is None:
+        return False, "", ""
+    cleaned = _unquote_outer(_strip_unquoted_comment(str(raw_value)).strip())
+    if not cleaned:
+        return False, "", ""
+    if not _hop_le_ten_nhanh_git(cleaned):
+        return True, "", f"nhanh_moi không hợp lệ: {cleaned}"
+    return True, cleaned, ""
+
+
+def parse_nhanh_moi(raw_value) -> str:
+    co_khai_bao, ten, loi = tach_nhanh_moi(raw_value)
+    if not co_khai_bao or loi:
+        return ""
+    return ten
+
