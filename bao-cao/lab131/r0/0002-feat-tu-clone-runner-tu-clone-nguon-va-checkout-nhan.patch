+
+    raw_nhanh_moi = (
+        meta.get("nhanh_moi")
+        if ("nhanh_moi" in meta and meta.get("nhanh_moi") is not None)
+        else (viec or {}).get("nhanh_moi")
+    )
+    co_nhanh_moi, nhanh_moi, loi_nhanh_moi = tach_nhanh_moi(raw_nhanh_moi)
+
+    raw_tracked = meta.get("theo_doi") or ((viec or {}).get("theo_doi") if isinstance(viec, dict) else "") or ""
+    cleaned_tracked = _strip_unquoted_comment(str(raw_tracked))
+    tracked_items = [item.strip() for item in cleaned_tracked.split(";") if item.strip()]
+    if not tracked_items:
+        msg = "clone hỏng: thiếu thư mục theo_doi để clone nguồn"
+        return {
+            "trang_thai": LY_DO_CLONE_HONG,
+            "dat": False,
+            "thu_muc": None,
+            "head_sau_clone": "",
+            "thong_diep_loi": msg,
+            "nhat_ky": msg,
+        }
+
+    target = Path(_unquote_outer(tracked_items[0]))
+    limit_dir = (cfg or {}).get("gioi_han_thu_muc")
+    if limit_dir is None and os.environ.get("LINHX_GIOI_HAN_THU_MUC", "").strip():
+        limit_dir = Path(os.environ["LINHX_GIOI_HAN_THU_MUC"].strip())
+    ok_dir, reason_dir = linhx_runner.kiem_tra_thu_muc_lam_viec(target, limit_dir)
+    if not ok_dir:
+        msg = f"clone hỏng: {reason_dir}"
+        return {
+            "trang_thai": LY_DO_CLONE_HONG,
+            "dat": False,
+            "thu_muc": target,
+            "head_sau_clone": "",
+            "thong_diep_loi": msg,
+            "nhat_ky": msg,
+        }
+
+    if loi_nguon:
+        msg = f"clone hỏng: {loi_nguon}"
+        return {
+            "trang_thai": LY_DO_CLONE_HONG,
+            "dat": False,
+            "thu_muc": target,
+            "head_sau_clone": "",
+            "thong_diep_loi": msg,
+            "nhat_ky": msg,
+        }
+    if co_nhanh_moi and loi_nhanh_moi:
+        msg = f"clone hỏng: {loi_nhanh_moi}"
+        return {
+            "trang_thai": LY_DO_CLONE_HONG,
+            "dat": False,
+            "thu_muc": target,
+            "head_sau_clone": "",
+            "thong_diep_loi": msg,
