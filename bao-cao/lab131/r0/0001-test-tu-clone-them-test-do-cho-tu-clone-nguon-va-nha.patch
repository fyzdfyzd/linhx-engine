+def test_runner_tu_clone_vao_theo_doi_dau_tien_va_checkout_nhanh_moi_truoc_agy(tmp_path):
+    src_bare, src_sha = _init_bare_source_repo(
+        tmp_path,
+        branch="claude/nhanh-goc",
+        files={
+            "src/core.py": "VAL = 1\n",
+            "README.md": "demo\n",
+        },
+    )
+    wt_first = tmp_path / "wt-chinh"
+    wt_second = tmp_path / "wt-phu"
+    assert not wt_first.exists()
+
+    bare_queue, cfg = _setup_queue_env(
+        tmp_path,
+        {
+            "01-tu-clone": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {wt_first}; {wt_second}\n"
+                f"nguon: {src_bare} claude/nhanh-goc\n"
+                "nhanh_moi: lx-r0-tu-clone\n\n"
+                "Sửa src/core.py trên repo đã được runner clone sẵn.\n"
+            )
+        },
+    )
+
+    quan_sat_trong_agy: dict[str, object] = {}
+
+    def _fake_agy(_c, viec):
+        quan_sat_trong_agy["ton_tai_wt1"] = wt_first.is_dir()
+        quan_sat_trong_agy["ton_tai_wt2"] = wt_second.exists()
+        quan_sat_trong_agy["nhanh_hien_tai"] = _run_git(["symbolic-ref", "--short", "HEAD"], wt_first)
+        quan_sat_trong_agy["head_truoc_sua"] = _run_git(["rev-parse", "HEAD"], wt_first)
+        quan_sat_trong_agy["noi_dung_core"] = (wt_first / "src" / "core.py").read_text(encoding="utf-8")
+        quan_sat_trong_agy["head_nhan_viec"] = viec.get("head_nhan")
+        _commit_files(wt_first, {"src/core.py": "VAL = 2\n"}, "cap nhat core")
+        return "xong", "Đã sửa xong không cần tự clone.", "exit=0", 10, 12
+
+    res = hang_doi_git.xu_ly_mot_phieu(cfg, chay_agy_fn=_fake_agy)
+    assert res is not None
+    assert res["trang_thai"] == "xong"
+    assert res["tu_clone"] == "da_clone"
+    assert quan_sat_trong_agy["ton_tai_wt1"] is True
+    assert quan_sat_trong_agy["ton_tai_wt2"] is False
+    assert quan_sat_trong_agy["nhanh_hien_tai"] == "lx-r0-tu-clone"
+    assert quan_sat_trong_agy["head_truoc_sua"] == src_sha
+    assert quan_sat_trong_agy["noi_dung_core"] == "VAL = 1\n"
+    assert quan_sat_trong_agy["head_nhan_viec"] == src_sha
+    assert "trang_thai: xong" in _read_ket_qua_from_bare(bare_queue, "01-tu-clone")
+
