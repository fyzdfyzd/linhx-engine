+def test_clone_hong_va_qua_tran_5_phut_ghi_loi_clone_hong_khong_goi_agy(tmp_path, monkeypatch):
+    src_bare, _ = _init_bare_source_repo(
+        tmp_path,
+        branch="main",
+        files={"a.txt": "ok\n"},
+    )
+    wt_bad_url = tmp_path / "wt-bad-url"
+    wt_bad_branch = tmp_path / "wt-bad-branch"
+    wt_timeout = tmp_path / "wt-timeout"
+    missing_bare = tmp_path / "khong-ton-tai.git"
+
+    bare_queue, cfg = _setup_queue_env(
+        tmp_path,
+        {
+            "01-url-hong": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {wt_bad_url}\n"
+                f"nguon: {missing_bare} main\n"
+                "nhanh_moi: nhanh-1\n\n"
+                "Repo nguồn không tồn tại.\n"
+            ),
+            "02-nhanh-hong": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {wt_bad_branch}\n"
+                f"nguon: {src_bare} nhanh-khong-co-that\n"
+                "nhanh_moi: nhanh-2\n\n"
+                "Nhánh nguồn không tồn tại.\n"
+            ),
+            "03-qua-tran": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {wt_timeout}\n"
+                f"nguon: {src_bare} main\n"
+                "nhanh_moi: nhanh-3\n\n"
+                "Clone bị treo quá trần 5 phút.\n"
+            ),
+        },
+    )
+
+    da_goi_agy: list[str] = []
+
+    def _khong_duoc_goi_agy(_c, viec):
+        da_goi_agy.append(viec["viec"])
+        return "xong", "Không được chạy tới đây", "exit=0", 1, 1
+
+    # 1. URL nguồn không tồn tại -> loi, ly_do: clone_hong, không gọi agy
+    res_1 = hang_doi_git.xu_ly_mot_phieu(cfg, chay_agy_fn=_khong_duoc_goi_agy)
+    assert res_1 is not None and res_1["viec"] == "01-url-hong"
+    assert res_1["trang_thai"] == "loi"
+    assert da_goi_agy == []
+    kq_1 = _read_ket_qua_from_bare(bare_queue, "01-url-hong")
+    assert "trang_thai: loi\n" in kq_1
+    assert "ly_do: clone_hong\n" in kq_1
+
+    # 2. Nhánh nguồn không tồn tại -> loi, ly_do: clone_hong, không gọi agy
+    res_2 = hang_doi_git.xu_ly_mot_phieu(cfg, chay_agy_fn=_khong_duoc_goi_agy)
+    assert res_2 is not None and res_2["viec"] == "02-nhanh-hong"
+    assert res_2["trang_thai"] == "loi"
+    assert da_goi_agy == []
+    kq_2 = _read_ket_qua_from_bare(bare_queue, "02-nhanh-hong")
+    assert "trang_thai: loi\n" in kq_2
+    assert "ly_do: clone_hong\n" in kq_2
+
+    # 3. Kiểm tra trần mặc định 5 phút (300s) được truyền vào bước chạy clone và khi quá trần -> clone_hong
+    ghi_nhan_timeout: list[float] = []
+    chay_clone_goc = hang_doi_git._chay_git_co_tran
+
+    def _gia_treo_clone(args, cwd, timeout_seconds):
+        ghi_nhan_timeout.append(float(timeout_seconds))
+        if "clone" in args:
+            return -1, "quá trần clone", True
+        return chay_clone_goc(args, cwd, timeout_seconds)
+
+    monkeypatch.setattr(hang_doi_git, "_chay_git_co_tran", _gia_treo_clone)
+    t0 = time.monotonic()
+    res_3 = hang_doi_git.xu_ly_mot_phieu(cfg, chay_agy_fn=_khong_duoc_goi_agy)
+    assert (time.monotonic() - t0) < 5.0
+    assert res_3 is not None and res_3["viec"] == "03-qua-tran"
+    assert res_3["trang_thai"] == "loi"
+    assert da_goi_agy == []
+    assert ghi_nhan_timeout and abs(ghi_nhan_timeout[0] - 300.0) <= 1.0
+    kq_3 = _read_ket_qua_from_bare(bare_queue, "03-qua-tran")
+    assert "trang_thai: loi\n" in kq_3
+    assert "ly_do: clone_hong\n" in kq_3
+
