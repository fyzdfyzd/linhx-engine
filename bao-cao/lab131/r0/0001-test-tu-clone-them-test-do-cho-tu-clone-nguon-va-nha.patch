+def test_phan_tich_header_nguon_nhanh_moi_va_hang_so_tran_5_phut():
+    raw = (
+        "may: may-2\n"
+        "loai: code\n"
+        "theo_doi: D:\\linhx\\wt-demo\n"
+        "nguon: git://192.168.1.136/linhx-engine.git claude/project-thread-jowxv1 # nguồn nội bộ\n"
+        "nhanh_moi: lx-r0-tu-clone # nhánh làm việc mới\n"
+        "tu_sua: 1\n\n"
+        "Làm việc trên nhánh đã clone sẵn.\n"
+    )
+    parsed = hang_doi_git.phan_tich_phieu(raw, "lx-r0-tu-clone")
+    assert parsed["nguon"] == (
+        "git://192.168.1.136/linhx-engine.git",
+        "claude/project-thread-jowxv1",
+    )
+    assert parsed["nhanh_moi"] == "lx-r0-tu-clone"
+    assert hang_doi_git.CLONE_TIMEOUT_MINUTES == 5.0
+    assert hang_doi_git.LY_DO_CLONE_HONG == "clone_hong"
+
+    repair_md = hang_doi_git.build_self_repair_ticket(parsed, "trang_thai: loi\n\nTest trượt.\n")
+    assert repair_md is not None
+    reparsed = hang_doi_git.phan_tich_phieu(repair_md, "lx-r0-tu-clone-sua-1")
+    assert reparsed["nguon"] == (
+        "git://192.168.1.136/linhx-engine.git",
+        "claude/project-thread-jowxv1",
+    )
+    assert reparsed["nhanh_moi"] == "lx-r0-tu-clone"
+
+    plain = hang_doi_git.phan_tich_phieu("may: bat-ky\n\nPhiếu cũ không tự clone.", "cu-01")
+    assert plain["nguon"] is None
+    assert plain["nhanh_moi"] == ""
