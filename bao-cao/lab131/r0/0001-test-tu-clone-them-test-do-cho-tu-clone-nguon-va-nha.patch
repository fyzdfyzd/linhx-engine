+def test_base_sha_quet_bi_mat_bang_head_sau_clone(tmp_path):
+    fake_sk_old = "".join(["s", "k-", "ant-", "OldHistoricalKey0123456789abcdef"])
+    fake_sk_new = "".join(["s", "k-", "ant-", "NewLeakedKeyAfterClone0123456789"])
+
+    src_bare, sha_sau_clone = _init_bare_source_repo(
+        tmp_path,
+        branch="main",
+        files={
+            "legacy_outside.py": f"# file cu truoc clone\nOLD_TOKEN = '{fake_sk_old}'\n",
+            "src/work.py": "x = 1\n",
+        },
+    )
+    wt_sach = tmp_path / "wt-sach"
+    wt_lo = tmp_path / "wt-lo"
+
+    bare_queue, cfg = _setup_queue_env(
+        tmp_path,
+        {
+            "01-commit-sach-sau-clone": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {wt_sach}\n"
+                f"nguon: {src_bare} main\n"
+                "nhanh_moi: feat-sach\n"
+                "vung: src/**\n\n"
+                "Sửa sạch trong src/** sau khi runner tự clone.\n"
+            ),
+            "02-commit-lo-bi-mat-sau-clone": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {wt_lo}\n"
+                f"nguon: {src_bare} main\n"
+                "nhanh_moi: feat-lo\n"
+                "vung: src/**\n\n"
+                "Commit lộ khoá mới sau mốc clone.\n"
+            ),
+        },
+    )
+
+    # 1. Nguồn có sẵn khoá lịch sử & file ngoài vùng từ trước clone, nhưng sau clone agy chỉ sửa sạch -> XONG
+    def _agy_sach(_c, viec):
+        assert viec["head_nhan"] == sha_sau_clone
+        _commit_files(wt_sach, {"src/work.py": "x = 2\n"}, "sua sach sau clone")
+        return "xong", "Đã sửa sạch.", "exit=0", 8, 8
+
+    res_1 = hang_doi_git.xu_ly_mot_phieu(cfg, chay_agy_fn=_agy_sach)
+    assert res_1 is not None
+    assert res_1["trang_thai"] == "xong"
+    assert res_1["bi_mat"] == []
+    assert res_1["ngoai_vung"] == []
+    assert res_1["so_file"] == 1
+    assert "trang_thai: xong" in _read_ket_qua_from_bare(bare_queue, "01-commit-sach-sau-clone")
+
+    # 2. Sau khi clone, agy commit thêm bí mật mới -> quét từ base_sha (= HEAD sau clone) bắt đúng file mới
+    def _agy_lo(_c, viec):
+        assert viec["head_nhan"] == sha_sau_clone
+        _commit_files(wt_lo, {"src/work.py": f"x = 2\nKEY = '{fake_sk_new}'\n"}, "lo bi mat moi")
+        return "xong", "Trót lộ khoá mới.", "exit=0", 8, 8
+
+    res_2 = hang_doi_git.xu_ly_mot_phieu(cfg, chay_agy_fn=_agy_lo)
