+def _run_git(args: list[str], cwd: Path) -> str:
+    env = os.environ.copy()
+    env["GIT_TERMINAL_PROMPT"] = "0"
+    extra_kw = {"creationflags": 0x08000000} if os.name == "nt" else {}
+    proc = subprocess.run(
+        ["git"] + list(args),
+        cwd=str(cwd),
+        env=env,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        check=True,
+        **extra_kw,
+    )
+    return proc.stdout.strip()
+
+
+def _init_bare_source_repo(
+    tmp_path: Path,
+    branch: str,
+    files: dict[str, str],
+    name: str = "nguon.git",
+) -> tuple[Path, str]:
+    """Tạo repo nguồn giả bằng `git init --bare` trong tmp_path (không mạng)."""
+    bare_dir = tmp_path / name
+    bare_dir.mkdir(parents=True, exist_ok=True)
+    _run_git(["init", "--bare"], bare_dir)
+
+    seed_dir = tmp_path / f"seed-{uuid.uuid4().hex[:6]}"
+    seed_dir.mkdir(parents=True, exist_ok=True)
+    _run_git(["init"], seed_dir)
+    _run_git(["config", "user.name", "seed-src"], seed_dir)
+    _run_git(["config", "user.email", "seed-src@linhx.local"], seed_dir)
+    _run_git(["config", "commit.gpgsign", "false"], seed_dir)
+    _run_git(["checkout", "-b", branch], seed_dir)
+    for rel, content in files.items():
+        file_path = seed_dir / rel
+        file_path.parent.mkdir(parents=True, exist_ok=True)
+        file_path.write_text(content, encoding="utf-8")
+    _run_git(["add", "-A"], seed_dir)
+    _run_git(["commit", "-m", "init source"], seed_dir)
+    head_sha = _run_git(["rev-parse", "HEAD"], seed_dir)
+    _run_git(["remote", "add", "origin", str(bare_dir)], seed_dir)
+    _run_git(["push", "origin", f"HEAD:refs/heads/{branch}"], seed_dir)
+    _run_git(["symbolic-ref", "HEAD", f"refs/heads/{branch}"], bare_dir)
+    return bare_dir, head_sha
+
+
+def _commit_files(repo_dir: Path, updates: dict[str, str], message: str = "update") -> str:
+    _run_git(["config", "user.name", "tho-test"], repo_dir)
+    _run_git(["config", "user.email", "tho@linhx.local"], repo_dir)
+    _run_git(["config", "commit.gpgsign", "false"], repo_dir)
+    for rel, content in updates.items():
+        p = repo_dir / rel
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(content, encoding="utf-8")
+    _run_git(["add", "-A"], repo_dir)
+    _run_git(["commit", "-m", message], repo_dir)
+    return _run_git(["rev-parse", "HEAD"], repo_dir)
+
+
+def _setup_queue_env(tmp_path: Path, tickets: dict[str, str]) -> tuple[Path, dict]:
+    bare_queue = tmp_path / f"queue-{uuid.uuid4().hex[:6]}.git"
+    bare_queue.mkdir(parents=True, exist_ok=True)
+    _run_git(["init", "--bare"], bare_queue)
+
+    seed = tmp_path / f"seed-q-{uuid.uuid4().hex[:6]}"
+    seed.mkdir(parents=True, exist_ok=True)
+    _run_git(["init"], seed)
+    _run_git(["config", "user.name", "seed"], seed)
+    _run_git(["config", "user.email", "seed@linhx.local"], seed)
+    _run_git(["config", "commit.gpgsign", "false"], seed)
+    _run_git(["checkout", "-b", "main"], seed)
+    (seed / "README.md").write_text("linhx\n", encoding="utf-8")
+    _run_git(["add", "-A"], seed)
+    _run_git(["commit", "-m", "init main"], seed)
+    _run_git(["remote", "add", "origin", str(bare_queue)], seed)
+    _run_git(["push", "origin", "main"], seed)
+    _run_git(["symbolic-ref", "HEAD", "refs/heads/main"], bare_queue)
+
+    _run_git(["checkout", "--orphan", "hang-doi"], seed)
+    _run_git(["rm", "-rf", "."], seed)
+    moi_dir = seed / "hang-doi" / "moi"
+    moi_dir.mkdir(parents=True, exist_ok=True)
+    for tid, body in tickets.items():
+        (moi_dir / f"{tid}.md").write_text(body, encoding="utf-8")
+    _run_git(["add", "-A"], seed)
+    _run_git(["commit", "-m", "seed hang-doi"], seed)
+    _run_git(["push", "origin", "hang-doi"], seed)
+
+    clone_dir = tmp_path / f"worker-clone-{uuid.uuid4().hex[:6]}"
+    _run_git(["clone", str(bare_queue), str(clone_dir)], tmp_path)
+    work_dir = tmp_path / f"worker-work-{uuid.uuid4().hex[:6]}"
+    work_dir.mkdir(parents=True, exist_ok=True)
+    cfg = {
+        "nguon": "github",
+        "tho": "may-2",
+        "agy": "agy-gia",
+        "agy_args": "--output-format json",
+        "thu_muc": work_dir,
+        "nghi": 0.01,
+        "repo_hang_doi": clone_dir,
+        "nhanh_hang_doi": "hang-doi",
+        "remote_hang_doi": "origin",
+        "wt_hang_doi": "",
+        "thu_muc_drive": tmp_path / "drive",
+        "thu_muc_log": tmp_path / "log",
+    }
+    return bare_queue, cfg
+
+
+def _read_ket_qua_from_bare(bare_queue: Path, ticket_id: str) -> str:
+    return _run_git(["show", f"hang-doi:hang-doi/xong/{ticket_id}/KET-QUA.md"], bare_queue)
+
