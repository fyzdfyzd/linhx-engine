+def test_b2_giu_hanh_vi_lenh_kiem_rong_va_chap_nhan_pytest_co_tep_hoac_k_hoac_m(tmp_path):
+    # (b) `lenh_kiem` rỗng vẫn chạy như cũ; `pytest` có đường dẫn tệp hoặc `-k` hoặc `-m` được nhận bình thường
