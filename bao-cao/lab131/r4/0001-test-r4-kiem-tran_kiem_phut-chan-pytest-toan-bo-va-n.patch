+def test_a2_lenh_kiem_chay_sau_agy_thoat_tran_rieng_khong_tinh_vao_tran_phut(tmp_path, monkeypatch):
+    # (a) `lenh_kiem` chạy SAU khi agy thoát, mặc định 5 phút (300s), trần riêng KHÔNG tính vào `tran_phut`
+    proj_dir = tmp_path / "wt-proj-a2"
+    proj_dir.mkdir(parents=True)
+    (proj_dir / "test_don.py").write_text("def test_mot():\n    assert 2 + 2 == 4\n", encoding="utf-8")
+
+    su_kien_file = tmp_path / "thu_tu_su_kien.log"
+    script_agy = tmp_path / "agy_nhanh.py"
+    script_agy.write_text(
+        "import json, pathlib, time\n"
+        f"p = pathlib.Path(r'{su_kien_file}')\n"
+        "with p.open('a', encoding='utf-8') as f:\n"
+        "    f.write('agy_bat_dau\\n')\n"
+        "time.sleep(0.1)\n"
+        "with p.open('a', encoding='utf-8') as f:\n"
+        "    f.write('agy_thoat\\n')\n"
+        "print(json.dumps({'status': 'SUCCESS', 'response': 'Đã sửa xong code.', 'usage': {'input_tokens': 12, 'output_tokens': 6}}))\n",
+        encoding="utf-8",
+    )
+
+    # `kiem_sau_agy.py` xác nhận agy đã thoát trước khi `lenh_kiem` bắt đầu, và ngủ 1.4s (> tran_phut 1.2s, < tran_kiem_phut 6s)
+    (proj_dir / "kiem_sau_agy.py").write_text(
+        "import pathlib, sys, time\n"
+        f"p = pathlib.Path(r'{su_kien_file}')\n"
+        "da_co = p.read_text(encoding='utf-8').splitlines() if p.exists() else []\n"
+        "if 'agy_thoat' not in da_co:\n"
+        "    print('LOI: lenh_kiem chay truoc khi agy thoat', file=sys.stderr)\n"
+        "    sys.exit(2)\n"
+        "with p.open('a', encoding='utf-8') as f:\n"
+        "    f.write('lenh_kiem_bat_dau\\n')\n"
+        "time.sleep(1.4)\n"
+        "with p.open('a', encoding='utf-8') as f:\n"
+        "    f.write('lenh_kiem_xong\\n')\n"
+        "print('KIEM_RIENG_XANH')\n",
+        encoding="utf-8",
+    )
+
+    py_exe = Path(sys.executable).as_posix()
+    tickets = {
+        "01-mac-dinh-5p": (
+            "may: may-2\n"
+            "loai: code\n"
+            f"theo_doi: {proj_dir}\n"
+            f'lenh_kiem: "{py_exe}" -m pytest test_don.py -q\n\n'
+            "Phiếu không khai báo tran_kiem_phut (dùng mặc định 5 phút).\n"
+        ),
+        "02-tran-rieng": (
+            "may: may-2\n"
+            "loai: code\n"
+            "tran_phut: 0.02\n"
+            "tran_kiem_phut: 0.1\n"
+            f"theo_doi: {proj_dir}\n"
+            f'lenh_kiem: "{py_exe}" kiem_sau_agy.py\n\n'
+            "Phiếu có tran_phut 1.2s nhưng lenh_kiem chạy 1.4s dưới trần riêng 6s.\n"
+        ),
+    }
+    bare_repo, cfg = _setup_queue_env(tmp_path, tickets, label="a2")
+
+    orig_popen = subprocess.Popen
+    monkeypatch.setattr(
+        linhx_runner,
+        "_tao_tien_trinh_agy",
+        lambda cmd, **kw: orig_popen([sys.executable, str(script_agy)], **kw),
+    )
+
+    recorded_timeouts: list[float] = []
+    orig_run_ver = hang_doi_git.run_verification_command
+
+    def _spy_run_ver(command: str, cwd: Path, timeout_seconds: float = 0.0, *args, **kwargs):
+        recorded_timeouts.append(float(timeout_seconds))
+        return orig_run_ver(command, cwd, timeout_seconds=timeout_seconds, *args, **kwargs)
+
+    monkeypatch.setattr(hang_doi_git, "run_verification_command", _spy_run_ver)
+
+    res_1 = hang_doi_git.xu_ly_mot_phieu(cfg)
+    assert res_1 is not None and res_1["viec"] == "01-mac-dinh-5p"
+    assert res_1["trang_thai"] == "xong"
+    assert recorded_timeouts[0] == pytest.approx(5.0 * 60.0)
+
+    su_kien_file.write_text("", encoding="utf-8")
+    res_2 = hang_doi_git.xu_ly_mot_phieu(cfg)
+    assert res_2 is not None and res_2["viec"] == "02-tran-rieng"
+    assert res_2["trang_thai"] == "xong"
+    assert recorded_timeouts[1] == pytest.approx(0.1 * 60.0)
+    assert su_kien_file.read_text(encoding="utf-8").splitlines() == [
+        "agy_bat_dau",
+        "agy_thoat",
+        "lenh_kiem_bat_dau",
+        "lenh_kiem_xong",
+    ]
+    kq_2 = _read_ket_qua_from_bare(bare_repo, "02-tran-rieng")
+    assert "trang_thai: xong\n" in kq_2
+
