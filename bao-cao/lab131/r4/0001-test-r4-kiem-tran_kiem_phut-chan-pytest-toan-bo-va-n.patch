+def test_a1_phan_tich_tran_kiem_phut_mac_dinh_5_va_tuy_chinh():
+    # (a) Header mới `tran_kiem_phut` có mặc định 5 và đọc được giá trị số nguyên/thực từ phiếu
+    p_mac_dinh = hang_doi_git.phan_tich_phieu("may: may-2\nloai: code\n\nLàm việc mặc định.", "p-mac-dinh")
+    assert p_mac_dinh["tran_kiem_phut"] == 5
+
+    p_nguyen = hang_doi_git.phan_tich_phieu(
+        "may: may-2\nloai: code\ntran_kiem_phut: 9 # trần kiểm riêng\n\nLàm việc 9 phút kiểm.",
+        "p-nguyen",
+    )
+    assert p_nguyen["tran_kiem_phut"] == 9
+
+    p_thuc = hang_doi_git.phan_tich_phieu(
+        "---\nmay: may-2\ntran_kiem_phut: 2.5\n---\nLàm việc frontmatter.",
+        "p-thuc",
+    )
+    assert p_thuc["tran_kiem_phut"] == pytest.approx(2.5)
+
+    p_sai = hang_doi_git.phan_tich_phieu(
+        "may: may-2\ntran_kiem_phut: khong-phai-so\n\nGiá trị hỏng phải về mặc định 5.",
+        "p-sai",
+    )
+    assert p_sai["tran_kiem_phut"] == 5
+
