+def test_a3_qua_tran_kiem_ghi_ket_qua_loi_ly_do_qua_tran_kiem(tmp_path):
+    # (a) Quá `tran_kiem_phut` -> diệt lệnh kiểm và ghi KET-QUA `trang_thai: loi`, `ly_do: qua_tran_kiem`
+    proj_dir = tmp_path / "wt-proj-a3"
+    proj_dir.mkdir(parents=True)
+    (proj_dir / "treo_kiem.py").write_text(
+        "import sys, time\n"
+        "sys.stdout.write('BAT_DAU_KIEM_CHAM\\n')\n"
+        "sys.stdout.flush()\n"
+        "time.sleep(1.8)\n",
+        encoding="utf-8",
+    )
+    py_exe = Path(sys.executable).as_posix()
+    bare_repo, cfg = _setup_queue_env(
+        tmp_path,
+        {
+            "01-qua-tran-kiem": (
+                "may: may-2\n"
+                "loai: code\n"
+                "tran_phut: 10\n"
+                "tran_kiem_phut: 0.006\n"
+                f"theo_doi: {proj_dir}\n"
+                f'lenh_kiem: "{py_exe}" treo_kiem.py\n\n'
+                "Kiểm tra vượt quá trần kiểm riêng trong header phiếu.\n"
+            )
+        },
+        label="a3",
+    )
+
+    t0 = time.monotonic()
+    res = hang_doi_git.xu_ly_mot_phieu(
+        cfg,
+        chay_agy_fn=lambda _c, _v: ("xong", "Agy xong nhanh.", "exit=0", 8, 4),
+    )
+    elapsed = time.monotonic() - t0
+
+    assert res is not None and res["viec"] == "01-qua-tran-kiem"
+    assert elapsed < 5.0
+    assert res["trang_thai"] == "loi"
+    kq_md = _read_ket_qua_from_bare(bare_repo, "01-qua-tran-kiem")
+    assert "trang_thai: loi\n" in kq_md
+    assert "ly_do: qua_tran_kiem\n" in kq_md
+
