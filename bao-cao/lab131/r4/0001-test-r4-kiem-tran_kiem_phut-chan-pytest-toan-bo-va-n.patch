+def test_b1_tu_choi_luc_nhan_phieu_khi_lenh_kiem_pytest_toan_bo(tmp_path):
+    # (b) `lenh_kiem` chạy toàn bộ (`pytest` không có đường dẫn tệp và không có `-k`/`-m`)
+    # -> từ chối ngay lúc nhận phiếu, không chạy agy, KET-QUA `loi` lý do `lenh_kiem_qua_rong`
+    proj_dir = tmp_path / "wt-proj-b1"
+    proj_dir.mkdir(parents=True)
+
+    # 1. Kiểm trực tiếp `nhan_phieu_git`: trả về None (từ chối nhận), không đẩy qua `dang/`, ghi thẳng KET-QUA
+    bare_1, cfg_1 = _setup_queue_env(
+        tmp_path,
+        {
+            "01-pytest-tran": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {proj_dir}\n"
+                "lenh_kiem: pytest\n\n"
+                "Phiếu chạy pytest trần toàn bộ.\n"
+            )
+        },
+        label="b1-don",
+    )
+    claimed = hang_doi_git.nhan_phieu_git(cfg_1)
+    assert claimed is None
+    assert _list_tree_files(bare_1, "moi") == []
+    assert _list_tree_files(bare_1, "dang") == []
+    log_dang = _run_git(["log", "--oneline", "hang-doi", "--", "hang-doi/dang/01-pytest-tran.md"], bare_1)
+    assert log_dang == ""
+    kq_1 = _read_ket_qua_from_bare(bare_1, "01-pytest-tran")
+    assert "trang_thai: loi\n" in kq_1
+    assert "ly_do: lenh_kiem_qua_rong\n" in kq_1
+
+    # 2. Kiểm các biến thể chạy rộng khác (`pytest -q`, `python -m pytest`, `pytest runner`) qua vòng runner
+    bare_2, cfg_2 = _setup_queue_env(
+        tmp_path,
+        {
+            "02-pytest-co": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {proj_dir}\n"
+                "lenh_kiem: pytest -q --tb=short\n\n"
+                "Chỉ có cờ hiển thị, không có tệp hay -k/-m.\n"
+            ),
+            "03-python-m-pytest": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {proj_dir}\n"
+                "lenh_kiem: python -m pytest -v\n\n"
+                "Cờ -m của python đứng trước pytest KHÔNG phải marker -m của pytest.\n"
+            ),
+            "04-pytest-thu-muc": (
+                "may: may-2\n"
+                "loai: code\n"
+                f"theo_doi: {proj_dir}\n"
+                "lenh_kiem: pytest runner\n\n"
+                "Truyền cả thư mục runner thay vì đường dẫn tệp test.\n"
+            ),
+        },
+        label="b1-nhieu",
+    )
+    agy_calls: list[str] = []
+
+    def _cam_goi_agy(_c, v):
+        agy_calls.append(v["viec"])
+        return "xong", "Không được gọi tới đây", "exit=0", 1, 1
+
+    hang_doi_git.vong_git(cfg_2, mot_lan=True, chay_agy_fn=_cam_goi_agy)
+    assert agy_calls == []
+    assert _list_tree_files(bare_2, "moi") == []
+    assert _list_tree_files(bare_2, "dang") == []
+    for tid in ("02-pytest-co", "03-python-m-pytest", "04-pytest-thu-muc"):
+        kq_txt = _read_ket_qua_from_bare(bare_2, tid)
+        assert "trang_thai: loi\n" in kq_txt
+        assert "ly_do: lenh_kiem_qua_rong\n" in kq_txt
