+            f"theo_doi: {proj_dir}\n"
+            f'lenh_kiem: "{py_exe}" -m pytest -m smoke -q\n\n'
+            "Phiếu lọc theo marker -m.\n"
+        ),
+    }
+    bare_repo, cfg = _setup_queue_env(tmp_path, tickets, label="b2")
+    agy_ran: list[str] = []
+
+    def _fake_agy(_c, v):
+        agy_ran.append(v["viec"])
