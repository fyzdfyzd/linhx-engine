+def _remove_tree(target_dir: Path) -> None:
+    # Xoá thư mục tạm an toàn kể cả các tệp chỉ-đọc trong .git trên Windows
+    if not target_dir.exists():
+        return
+
+    def _on_readonly(func, path_str, _):
+        try:
+            os.chmod(path_str, stat.S_IWRITE)
+            func(path_str)
+        except OSError:
+            pass
+
+    shutil.rmtree(target_dir, onerror=_on_readonly)
+
+
+@pytest.fixture
+def tmp_path():
+    # Dựng thư mục tạm cục bộ trong runner/viec (không dùng conftest, không chạm ngoài vùng)
+    work_root = linhx_runner.GOC / "viec"
+    existed_before = work_root.exists()
+    temp_root = work_root / f"pytest-tmp-r4-{os.getpid()}-{uuid.uuid4().hex[:8]}"
+    temp_root.mkdir(parents=True, exist_ok=True)
+    try:
+        yield temp_root
+    finally:
+        _remove_tree(temp_root)
+        if not existed_before and work_root.exists():
+            try:
+                next(work_root.iterdir())
+            except StopIteration:
+                work_root.rmdir()
+
+
+def _run_git(args: list[str], cwd: Path) -> str:
+    # Chạy git cục bộ ở tiền cảnh, khoá lời nhắc đăng nhập để test thuần cục bộ
+    env = os.environ.copy()
+    env["GIT_TERMINAL_PROMPT"] = "0"
+    extra_kw = {"creationflags": 0x08000000} if os.name == "nt" else {}
+    proc = subprocess.run(
+        ["git"] + list(args),
+        cwd=str(cwd),
+        env=env,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        check=True,
+        **extra_kw,
+    )
+    return proc.stdout.strip()
+
+
+def _setup_queue_env(tmp_path: Path, tickets: dict[str, str], label: str = "q") -> tuple[Path, dict]:
+    # Khởi tạo bare repo nhánh hang-doi và bản clone của máy thợ cục bộ
+    sub = tmp_path / f"{label}-{uuid.uuid4().hex[:6]}"
+    sub.mkdir(parents=True, exist_ok=True)
+    bare_repo = sub / "remote.git"
+    bare_repo.mkdir()
+    _run_git(["init", "--bare"], bare_repo)
+
+    seed = sub / "seed"
+    seed.mkdir()
+    _run_git(["init"], seed)
+    _run_git(["config", "user.name", "seed"], seed)
+    _run_git(["config", "user.email", "seed@linhx.local"], seed)
+    _run_git(["config", "commit.gpgsign", "false"], seed)
+    _run_git(["checkout", "-b", "main"], seed)
+    (seed / "README.md").write_text("linhx\n", encoding="utf-8")
+    _run_git(["add", "-A"], seed)
+    _run_git(["commit", "-m", "init"], seed)
+    _run_git(["remote", "add", "origin", str(bare_repo)], seed)
+    _run_git(["push", "origin", "main"], seed)
+    _run_git(["symbolic-ref", "HEAD", "refs/heads/main"], bare_repo)
+
+    _run_git(["checkout", "--orphan", "hang-doi"], seed)
+    _run_git(["rm", "-rf", "."], seed)
+    moi_dir = seed / "hang-doi" / "moi"
+    moi_dir.mkdir(parents=True, exist_ok=True)
+    (moi_dir / ".gitkeep").write_text("", encoding="utf-8")
+    for tid, body in tickets.items():
+        (moi_dir / f"{tid}.md").write_text(body, encoding="utf-8")
+    _run_git(["add", "-A"], seed)
+    _run_git(["commit", "-m", "seed queue"], seed)
+    _run_git(["push", "origin", "hang-doi"], seed)
+
+    clone_dir = sub / "worker-clone"
+    _run_git(["clone", str(bare_repo), str(clone_dir)], sub)
+    work_dir = sub / "worker-work"
+    work_dir.mkdir()
+    cfg = {
+        "nguon": "github",
+        "tho": "may-2",
+        "agy": "agy-gia",
+        "agy_args": "--output-format json",
+        "thu_muc": work_dir,
+        "nghi": 0.01,
+        "repo_hang_doi": clone_dir,
+        "nhanh_hang_doi": "hang-doi",
+        "remote_hang_doi": "origin",
+        "wt_hang_doi": "",
+        "thu_muc_drive": sub / "drive",
+        "thu_muc_log": sub / "log",
+    }
+    return bare_repo, cfg
+
+
+def _read_ket_qua_from_bare(bare_repo: Path, ticket_id: str) -> str:
+    return _run_git(["show", f"hang-doi:hang-doi/xong/{ticket_id}/KET-QUA.md"], bare_repo)
+
+
+def _list_tree_files(bare_repo: Path, subpath: str) -> list[str]:
+    out = _run_git(["ls-tree", "--name-only", "hang-doi", f"hang-doi/{subpath}/"], bare_repo)
+    return [line.strip() for line in out.splitlines() if line.strip() and not line.strip().endswith("/.gitkeep")]
+
