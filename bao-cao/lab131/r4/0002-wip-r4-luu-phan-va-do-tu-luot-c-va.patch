+def _split_shell_subcommands(command: str) -> list[str]:
+    # Tách chuỗi lệnh shell theo `;`, `&&`, `||`, `|`, xuống dòng khi nằm ngoài dấu nháy
+    parts: list[str] = []
+    buf: list[str] = []
+    quote_char: str | None = None
+    idx = 0
+    n = len(command)
+    while idx < n:
+        ch = command[idx]
+        if quote_char is not None:
+            if ch == "\\" and quote_char == '"' and idx + 1 < n and command[idx + 1] == '"':
+                buf.append(ch)
+                buf.append(command[idx + 1])
+                idx += 2
+                continue
+            if ch == quote_char:
+                quote_char = None
+            buf.append(ch)
+            idx += 1
+            continue
+        if ch in ("'", '"'):
+            quote_char = ch
+            buf.append(ch)
+            idx += 1
+            continue
+        if ch in (";", "\n"):
+            seg = "".join(buf).strip()
+            if seg:
+                parts.append(seg)
+            buf.clear()
+            idx += 1
+            continue
+        if ch in ("&", "|"):
+            if idx + 1 < n and command[idx + 1] == ch:
+                idx += 2
+            else:
+                idx += 1
+            seg = "".join(buf).strip()
+            if seg:
+                parts.append(seg)
+            buf.clear()
+            continue
+        buf.append(ch)
+        idx += 1
+    tail = "".join(buf).strip()
+    if tail:
+        parts.append(tail)
+    return parts
+
+
+def _tokenize_shell_segment(segment: str) -> list[str]:
+    # Tách tham số một lệnh đơn, bảo toàn dấu `\` trong đường dẫn Windows và gỡ cặp nháy bao ngoài
+    tokens: list[str] = []
+    cur: list[str] = []
+    in_token = False
+    quote_char: str | None = None
+    idx = 0
+    n = len(segment)
+    while idx < n:
+        ch = segment[idx]
+        if quote_char is not None:
+            if ch == "\\" and quote_char == '"' and idx + 1 < n and segment[idx + 1] == '"':
+                cur.append('"')
+                idx += 2
+                continue
+            if ch == quote_char:
+                quote_char = None
+                idx += 1
+                continue
+            cur.append(ch)
+            idx += 1
+            continue
+        if ch in ("'", '"'):
+            quote_char = ch
+            in_token = True
+            idx += 1
+            continue
+        if ch.isspace():
+            if in_token:
+                tokens.append("".join(cur))
+                cur.clear()
+                in_token = False
+            idx += 1
+            continue
+        cur.append(ch)
+        in_token = True
+        idx += 1
+    if in_token:
+        tokens.append("".join(cur))
+    return tokens
+
+
+def _exe_stem(token: str) -> str:
+    base = str(token or "").replace("\\", "/").rsplit("/", 1)[-1].strip().lower()
+    for ext in (".exe", ".cmd", ".bat", ".ps1"):
+        if base.endswith(ext) and len(base) > len(ext):
+            return base[: -len(ext)]
+    return base
+
+
+def _extract_pytest_args_from_tokens(tokens: list[str]) -> list[str] | None:
+    # Trả về danh sách đối số sau `pytest` nếu lệnh này gọi pytest, hoặc None nếu không phải pytest
+    idx = 0
+    n = len(tokens)
+    while idx < n and _ENV_ASSIGN_RE.match(tokens[idx]) and not linhx_runner._la_duong_dan_win_tuyet_doi(tokens[idx]):
+        idx += 1
+    if idx + 1 < n and _exe_stem(tokens[idx]) in ("uv", "poetry", "pipenv", "pdm") and tokens[idx + 1].lower() == "run":
+        idx += 2
+    if idx >= n:
+        return None
+    stem = _exe_stem(tokens[idx])
+    if stem in ("pytest", "py.test"):
+        return tokens[idx + 1 :]
+    if _PYTHON_EXE_RE.match(stem):
+        j = idx + 1
+        while j < n:
+            tok = tokens[j]
+            if tok == "-m":
+                if j + 1 < n and _exe_stem(tokens[j + 1]) in ("pytest", "py.test"):
+                    return tokens[j + 2 :]
+                return None
+            if tok.lower() in ("-mpytest", "-mpy.test"):
+                return tokens[j + 1 :]
+            if tok == "-c":
+                return None
+            if tok in ("-W", "-X"):
+                j += 2
+                continue
+            if tok.startswith("-"):
+                j += 1
+                continue
+            return None
+    return None
+
+
+def _classify_pytest_target(tok: str, file_targets: list[str], dir_targets: list[str]) -> None:
+    path_part = str(tok or "").split("::", 1)[0].strip()
+    if not path_part or path_part.endswith(("/", "\\")) or path_part in (".", ".."):
+        dir_targets.append(tok)
+        return
+    if path_part.lower().endswith(".py"):
+        file_targets.append(tok)
+    else:
+        dir_targets.append(tok)
+
+
+def _is_pytest_args_too_broad(pytest_args: list[str]) -> bool:
+    has_filter = False
+    file_targets: list[str] = []
+    dir_targets: list[str] = []
+    after_ddash = False
+    i = 0
+    n = len(pytest_args)
+    while i < n:
+        tok = pytest_args[i]
+        if after_ddash:
+            _classify_pytest_target(tok, file_targets, dir_targets)
+            i += 1
+            continue
+        if tok == "--":
+            after_ddash = True
+            i += 1
+            continue
+        if tok in ("-k", "-m"):
+            if i + 1 < n and pytest_args[i + 1].strip():
+                has_filter = True
+            i += 2
+            continue
+        if tok.startswith(("-k=", "-m=")):
+            if tok.split("=", 1)[1].strip():
+                has_filter = True
+            i += 1
+            continue
+        if not tok.startswith("--") and len(tok) > 2 and tok[:2] in ("-k", "-m"):
+            if tok[2:].strip():
+                has_filter = True
+            i += 1
+            continue
+        if tok in _PYTEST_OPTS_TAKING_VALUE:
+            i += 2
+            continue
+        if tok.startswith("-"):
+            i += 1
+            continue
+        _classify_pytest_target(tok, file_targets, dir_targets)
+        i += 1
+    if has_filter:
+        return False
+    if file_targets and not dir_targets:
+        return False
+    return True
+
+
+def is_lenh_kiem_pytest_toan_bo(raw_lenh_kiem) -> bool:
+    # Kiểm tra `lenh_kiem` có gọi pytest quá rộng (thiếu đường dẫn tệp `.py` và thiếu `-k`/`-m`) hay không
+    cleaned = parse_lenh_kiem(raw_lenh_kiem)
+    if not cleaned:
+        return False
+    for subcmd in _split_shell_subcommands(cleaned):
+        tokens = _tokenize_shell_segment(subcmd)
+        pytest_args = _extract_pytest_args_from_tokens(tokens)
+        if pytest_args is not None and _is_pytest_args_too_broad(pytest_args):
+            return True
+    return False
+
