{$SITE_ADDR::80} {
	encode gzip

	handle_path /linhx/* {
		reverse_proxy backend:8000 {
			header_up X-Frappe-Site-Name linhx
			header_up Host linhx
		}
	}
	@ifagent_api path /ifagent/api/* /ifagent/app /ifagent/app/* /ifagent/assets/* /ifagent/files/* /ifagent/private/* /ifagent/socket.io/* /ifagent/login* /ifagent/desk*
	handle @ifagent_api {
		uri strip_prefix /ifagent
		reverse_proxy backend:8000 {
			header_up X-Frappe-Site-Name ifagent
			header_up Host ifagent
		}
	}
	@trang_ifagent path /ifagent /ifagent/*
	handle @trang_ifagent {
		uri strip_prefix /ifagent
		root * /srv/ifagent
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
	@ifagent_tinh path /_next/* /kham /kham/* /kham.html
	handle @ifagent_tinh {
		root * /srv/ifagent
		try_files {path} {path}.html {path}/index.html /kham.html
		file_server
	}
	@api_form path /api/method/linhx_core.crm.api_form.*
	handle @api_form {
		reverse_proxy backend:8000 {
			header_up X-Frappe-Site-Name ifagent
			header_up Host ifagent
		}
	}
	handle_path /sites/linhx/* {
		reverse_proxy backend:8000 {
			header_up X-Frappe-Site-Name linhx
			header_up Host linhx
		}
	}
	handle_path /sites/ifagent/* {
		reverse_proxy backend:8000 {
			header_up X-Frappe-Site-Name ifagent
			header_up Host ifagent
		}
	}

	@host_linhx header_regexp Host ^linhx(\..+)?(:[0-9]+)?$
	handle @host_linhx {
		reverse_proxy backend:8000 {
			header_up X-Frappe-Site-Name linhx
			header_up Host linhx
		}
	}

	@host_ifagent header_regexp Host ^ifagent(\..+)?(:[0-9]+)?$
	handle @host_ifagent {
		@host_ifagent_api path /api/* /app /app/* /assets/* /files/* /private/* /socket.io/* /login* /desk*
		handle @host_ifagent_api {
			reverse_proxy backend:8000 {
				header_up X-Frappe-Site-Name ifagent
				header_up Host ifagent
			}
		}
		handle {
			root * /srv/ifagent
			try_files {path} {path}.html {path}/index.html /index.html
			file_server
		}
	}

	@frappe path /api/* /app /app/* /assets/* /files/* /private/* /socket.io/* /login /login* /desk* /website_script.js /logout /update-password* /me
	handle @frappe {
		reverse_proxy frontend:8080
	}
	handle {
		root * /srv/front
		try_files {path} /index.html
		file_server
	}
}
