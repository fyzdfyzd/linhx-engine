# Chep thanh tho.env, dien cau hinh phu hop. KHONG dua tho.env len git.
# LINHX_NGUON=github de lay viec tu nhanh hang-doi tren GitHub (mac dinh: engine)
LINHX_NGUON=engine
LINHX_URL=https://engine.example.com
LINHX_TOKEN=key:secret
LINHX_THO=may-cty
AGY_CMD=C:\Users\ADMIN\.gemini\bin\agy.exe
AGY_ARGS=--output-format json --settings D:\linhx\linhx-runner\agy-settings.json --print-timeout 600s
LINHX_NGHI=15
