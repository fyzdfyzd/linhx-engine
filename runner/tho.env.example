# Chep thanh tho.env, dien cau hinh phu hop. KHONG dua tho.env len git.
# LINHX_NGUON=github de lay viec tu nhanh hang-doi tren GitHub (mac dinh: engine)
# LINHX_DRIVE=G:\My Drive\LINHX-VIEC (thu muc Drive chua tep nang > 1 MB)
# LINHX_LOG_DIR=D:\linhx\linhx-runner\log (thu muc log jsonl day du tren may)
# LINHX_SO_PHIEU=1 (so phieu code chay song song toi da tren may; trinh-duyet luon toi da 1)
# LINHX_TRAN_PHUT=40 | LINHX_KHONG_TIEN_PHUT=10 | LINHX_RAM_TOI_THIEU_GB=1.5
LINHX_NGUON=engine
LINHX_URL=https://engine.example.com
LINHX_TOKEN=key:secret
LINHX_THO=may-cty
AGY_CMD=C:\Users\ADMIN\.gemini\bin\agy.exe
AGY_ARGS=--output-format json --settings D:\linhx\linhx-runner\agy-settings.json --print-timeout 600s
LINHX_NGHI=15
LINHX_SO_PHIEU=1
