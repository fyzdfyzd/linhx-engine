  },
  "expect": {
   "direction": "higher",
   "against": "others"
  }
 },
 {
  "id": "not-x-but-y",
  "claim": "AI hay dựng câu đối lập 'not just X but Y' / 'it's not X, it's Y'",
  "source": "humanizer #1; Antislop 2025 regex",
  "metric": {
   "kind": "regex",
   "pattern": "\\bnot (?:just|only|merely|simply)\\b[^.!?\\n]{1,80}?\\bbut\\b|\\b(?:it|this|that)(?:'s|’s| is)n?(?:'t|’t)? (?:not )?(?:about )?[^.!?\\n]{1,40}?[.;,—–-]\\s*(?:it|this|that)(?:'s|’s| is)\\b",
   "flags": "i",
   "unit": "per_1k_words"
  },
  "expect": {
   "direction": "higher",
   "against": "others"
  }
 },
