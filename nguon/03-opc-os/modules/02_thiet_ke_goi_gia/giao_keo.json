{
  "module_id": "02_thiet_ke_goi_gia",
  "name": "Thiết kế gói giá, combo, mã giảm theo dịp & thử A/B",
  "version": "1.0.0",
  "owner_c_board": "Chị Đóng Gói (CPO)",
  "submodules": [
    "2.1_bac_gia_tiers",
    "2.2_combo_bundle",
    "2.3_ma_giam_theo_dip",
    "2.4_kiem_cua_kinh_te_don_vi",
    "2.5_thu_gia_ab"
  ],
  "events_in": ["gia.yeu_cau_tinh"],
  "events_out": ["gia.da_tinh", "gia.de_xuat_ab_cho_duyet"],
  "input_schema": {
    "type": "object",
    "required": ["opc_id", "tier_id"],
    "properties": {
      "opc_id": {"type": "string"},
      "tier_id": {"type": "string"},
      "coupon_code": {"type": "string"},
      "check_date": {"type": "string"}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["opc_id", "tier_id", "base_price", "final_price", "unit_economics_gate_passed"],
    "properties": {
      "opc_id": {"type": "string"},
      "tier_id": {"type": "string"},
      "base_price": {"type": "integer"},
      "discount_amount": {"type": "integer"},
      "final_price": {"type": "integer"},
      "max_ad_cac_allowed_40pct": {"type": "integer"},
      "unit_economics_gate_passed": {"type": "boolean"}
    }
  }
}
